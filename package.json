{
  "name": "mmpi-trainer",
  "version": "2.0.0",
  "private": true,
  "license": "UNLICENSED",
  "author": "Одиночная палата",
  "type": "module",
  "description": "Тренажёр психологических тестов (СМОЛ, СМИЛ, ММИЛ, Люшер): сайт на Vite + TypeScript, подсчёт на сервере (Node.js)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --config vite.server.config.ts && vite-node tools/check-leaks.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "new-test": "node tools/new-test.mjs",
    "fixture": "vite-node tools/make-fixture.ts --",
    "e2e": "node tools/e2e/smoke.mjs",
    "perf": "node tools/e2e/perf.mjs",
    "start": "node dist-server/main.mjs",
    "preview": "npm run build && npm start",
    "build:pages": "tsc --noEmit && vite build --mode pages --outDir dist-pages"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@fontsource-variable/golos-text": "^5.3.0"
  }
}
