{
  "name": "mmpi-trainer",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Тренажёр психологических тестов (СМОЛ, СМИЛ и другие): статический сайт на Vite + TypeScript",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "new-test": "node tools/new-test.mjs",
    "fixture": "vite-node tools/make-fixture.ts --",
    "e2e": "node tools/e2e/smoke.mjs",
    "perf": "node tools/e2e/perf.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
